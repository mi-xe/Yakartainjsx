{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "jsx-a11y",
    "oxc"
  ],
  "env": {
    "browser": true,
    "es2022": true
  },
  "rules": {
    "react/jsx-key": "error",
    "react/no-unknown-property": "error",
    "react/react-in-jsx-scope": "off",
    "jsx-a11y/alt-text": "warn",
    "jsx-a11y/label-has-associated-control": "warn"
  }
}
